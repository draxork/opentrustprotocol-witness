{
  "name": "opentrustprotocol-witness",
  "version": "4.0.4",
  "description": "Performance Witness & Analytics Engine for OpenTrust Protocol - Real-world outcome tracking and performance measurement",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:api": "jest tests/api-integration.test.ts",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "clean": "rm -rf dist",
    "start": "node dist/server.js",
    "start:dev": "ts-node src/server.ts",
    "docker:build": "docker build -t opentrustprotocol-witness .",
    "docker:run": "docker run -p 3000:3000 -p 8080:8080 opentrustprotocol-witness",
    "docker:compose": "docker-compose up",
    "docker:compose:prod": "docker-compose --profile production up",
    "docker:compose:monitoring": "docker-compose --profile monitoring up",
    "prepublishOnly": "npm run clean && npm run build && npm test",
    "dev": "tsc --watch"
  },
  "keywords": [
    "neutrosophy",
    "performance-witness",
    "analytics",
    "outcome-tracking",
    "trust",
    "uncertainty"
  ],
  "author": "OpenTrust Protocol Team",
  "license": "MIT",
    "repository": {
    "type": "git",
    "url": "git+https://github.com/draxork/opentrustprotocol-witness.git"
  },
  "homepage": "https://github.com/draxork/opentrustprotocol-witness#readme",
  "bugs": {
    "url": "https://github.com/draxork/opentrustprotocol-witness/issues"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "opentrustprotocol": "^3.0.0",
    "pg": "^8.11.3",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.0",
    "uuid": "^9.0.0",
    "ws": "^8.14.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.0.0",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.0.0",
    "@types/pg": "^8.10.9",
    "@types/supertest": "^6.0.3",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/uuid": "^9.0.0",
    "@types/ws": "^8.5.10",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "jest": "^29.0.0",
    "supertest": "^7.1.4",
    "ts-jest": "^29.0.0",
    "typescript": "^5.0.0"
  },
  "files": [
    "dist/**/*",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=16.0.0"
  }
}
